# Copy this file to server/.env (running "node scripts/dev.mjs" does it for you).
# The real .env holds secrets. Never commit it and never share it.

NODE_ENV=development
PORT=5000

# Database. Local MongoDB: mongodb://127.0.0.1:27017/ai-finance-tracker
# MongoDB Atlas: paste your connection string and add /ai-finance-tracker before the "?".
MONGODB_URI=mongodb://127.0.0.1:27017/ai-finance-tracker

# At least 32 random characters. The launcher generates one for you.
# To make one yourself: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=D_8iQ2DUYm_7AgnvmXZAM5ofwzDKBb9tFR5i7rp33eY4dReeWyS2NvAoJUOqqtEv
# How long a sign in lasts, in days (1 to 90).
SESSION_DAYS=7
# lax is right for almost everyone. strict is also allowed.
COOKIE_SAMESITE=lax

# The address people type to open the site, with no path. Several can be separated by commas.
# Required in production, for example https://app.yourdomain.com
FRONTEND_URL=http://localhost:5173

# Set to 1 when the server sits behind a host or proxy (Render, Railway, Fly, nginx),
# so rate limiting sees the real visitor address instead of the proxy's.
TRUST_PROXY=0

# true: this server also serves the built website (npm run build first). Defaults to true in production.
SERVE_CLIENT=

# Optional. Leave empty to use the built-in insights. The key is only ever used on the server.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
